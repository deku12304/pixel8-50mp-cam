<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Existing AutoFitTextureView -->
    <com.pixel8.ultra50mp.AutoFitTextureView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- New Grid & Horizon Level Overlay -->
    <com.pixel8.ultra50mp.CameraOverlayView
        android:id="@+id/cameraOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Bar: Status Badge, Grid Toggle, and Natural HDR Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="50MP • NATURAL"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/btnGridToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_bg"
            android:checked="true"
            android:paddingHorizontal="10dp"
            android:textColor="#FFFFFF"
            android:textOff="GRID OFF"
            android:textOn="GRID ON"
            android:textSize="12sp" />

        <ToggleButton
            android:id="@+id/btnHdrToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_bg"
            android:checked="true"
            android:paddingHorizontal="10dp"
            android:textColor="#FFFFFF"
            android:textOff="HDR OFF"
            android:textOn="HDR ON"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bottom Bar: Shutter Button & Google Photos Thumbnail Preview -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:paddingHorizontal="36dp">

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerInParent="true"
            android:background="@drawable/shutter_button_bg"
            android:contentDescription="Shutter" />

        <ImageButton
            android:id="@+id/btnPreviewThumbnail"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/badge_bg"
            android:contentDescription="Open in Google Photos"
            android:padding="2dp"
            android:scaleType="centerCrop" />

    </RelativeLayout>

</FrameLayout>
